# India — Razorpay INR. Also enable International payments in Dashboard for non-India cards.
# Your Razorpay merchant keys — never put these in the Windows app.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Plan ids from Razorpay Dashboard → Subscriptions → Plans (currency INR).
RAZORPAY_PLAN_MONTHLY=plan_xxxxxxxx
RAZORPAY_PLAN_YEARLY=plan_xxxxxxxx

# USA / outside India — Razorpay International USD plans ($2.99/mo, $29.99/yr suggested).
# Create Subscriptions → Plans with currency USD after International payments are activated.
RAZORPAY_PLAN_MONTHLY_USD=plan_xxxxxxxx
RAZORPAY_PLAN_YEARLY_USD=plan_xxxxxxxx

# Public origin of this website (webhooks + OAuth).
PYCLIPS_PUBLIC_URL=https://pyclips.in
# Required on Railway so unused redeem codes survive deploys.
# Create a volume and mount it at /data. The image already sets:
PYCLIPS_DATA_DIR=/data

# Optional — otherwise the site reuses data/oauth.json from the PyClips app.
# In Google Cloud Console → APIs & Services → Credentials → OAuth client (Web):
# Authorized JavaScript origins:
#   https://pyclips.in
#   http://127.0.0.1:8001
# Authorized redirect URIs:
#   https://pyclips.in/api/auth/google/callback
#   http://127.0.0.1:8001/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
